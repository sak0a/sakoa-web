diff --git a/sakaCOLORS/scripting/sakaCOLORS/web_sync.inc b/sakaCOLORS/scripting/sakaCOLORS/web_sync.inc
new file mode 100644
--- /dev/null
+++ b/sakaCOLORS/scripting/sakaCOLORS/web_sync.inc
@@ -0,0 +1,65 @@
+#if defined _sakacolors_web_sync_included
+    #endinput
+#endif
+#define _sakacolors_web_sync_included
+
+// Website writes increment webRevision in the same transaction as the colors.
+// Every game snapshot carries its loaded revision and is conditional on it,
+// including queued retries and synchronous unload saves. The website wins over
+// an older in-memory edit; after refresh, ordinary in-game edits work as before.
+Handle g_hWebPreferenceTimer = null;
+bool g_bWebPreferenceQueryPending = false;
+
+stock void StartWebPreferenceSync() {
+    g_hWebPreferenceTimer = CreateTimer(5.0, Timer_WebPreferences, _, TIMER_REPEAT);
+}
+
+stock void StopWebPreferenceSync() {
+    delete g_hWebPreferenceTimer;
+    g_hWebPreferenceTimer = null;
+}
+
+public Action Timer_WebPreferences(Handle timer) {
+    if (DB == null || g_bWebPreferenceQueryPending) return Plugin_Continue;
+    // Bound the read to connected identities, one query per server per interval.
+    char identities[8192];
+    char literal[SAKA_DATABASE_HEX_LITERAL_SIZE(SAKA_MAX_STEAMID_LENGTH)];
+    bool anyPlayers = false;
+    for (int client = 1; client <= MaxClients; client++) {
+        if (!Saka_IsValidClient(client) || !IsPlayerLoaded(client)) continue;
+        if (!EncodeRuntimeValue(CI[client].sSteamId, literal, sizeof(literal))) continue;
+        if (anyPlayers) StrCat(identities, sizeof(identities), ",");
+        StrCat(identities, sizeof(identities), literal);
+        anyPlayers = true;
+    }
+    if (!anyPlayers) return Plugin_Continue;
+    char query[9216];
+    Format(query, sizeof(query), "SELECT steamid,name,groupName,premiumPreviousGroup,premiumOverrideOwned,tag,nameColor,chatColor,useGroupTag,useGroupNameColor,useGroupChatColor,webRevision FROM sakaColors_Clients WHERE steamid IN (%s);", identities);
+    g_bWebPreferenceQueryPending = true;
+    view_as<Database>(DB).Query(OnWebPreferencesLoaded, query);
+    return Plugin_Continue;
+}
+
+public void OnWebPreferencesLoaded(Database db, DBResultSet results, const char[] error, any data) {
+    g_bWebPreferenceQueryPending = false;
+    if (results == null) {
+        Saka_LogError("database", "action=web_preferences_refresh_failed error=%s", error);
+        return;
+    }
+    while (results.FetchRow()) {
+        PlayerInfo persisted;
+        ReadPlayerResult(results, persisted);
+        int client = FindPlayerBySteamId(persisted.sSteamId);
+        if (!Saka_IsValidClient(client) || !IsPlayerLoaded(client)
+            || persisted.iWebRevision <= CI[client].iWebRevision) continue;
+        // Do not touch premium ownership, admin group changes, or player names.
+        strcopy(CI[client].sTag, sizeof(CI[].sTag), persisted.sTag);
+        strcopy(CI[client].sNameColor, sizeof(CI[].sNameColor), persisted.sNameColor);
+        strcopy(CI[client].sChatColor, sizeof(CI[].sChatColor), persisted.sChatColor);
+        CI[client].bUseGroupTag = persisted.bUseGroupTag;
+        CI[client].bUseGroupNameColor = persisted.bUseGroupNameColor;
+        CI[client].bUseGroupChatColor = persisted.bUseGroupChatColor;
+        CI[client].iWebRevision = persisted.iWebRevision;
+        CachePlayerPersonalFields(CI[client]);
+    }
+}
