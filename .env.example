# External MySQL database shared by the web application and Discord worker.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=dodgeball
DB_PASSWORD=replace-with-a-strong-password
DB_NAME=sakaStats

# Web/admin secrets. Use at least 32 random bytes for ADMIN_SESSION_SECRET.
ADMIN_PASSWORD=replace-with-a-strong-admin-password
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-bytes
STEAM_API_KEY=
# Comma-separated SteamID64 allowlist for TF2 operations. Password login cannot access these routes.
ADMIN_STEAM_IDS=
PTERODACTYL_URL=https://panel.f.sakoa.xyz
PTERODACTYL_API_KEY=
# Map SourceBans server IDs to Pterodactyl identifiers. Keep the value as one JSON object.
TF2_SERVER_MAP={"2":"29fcc8a6","4":"e7ecd530"}
# Enable only after installing the webRevision-aware COLORS plugin on every server.
PLAYER_COLOR_WRITES_ENABLED=false

# Discord credentials are consumed only by the private bot container.
DISCORD_TOKEN=
BOT_INSTANCE_ID=dodgeball-bot
BOT_HEARTBEAT_STALE_SECONDS=120
DISCORD_JOB_POLL_MS=2000
DISCORD_CONFIG_POLL_MS=10000
DISCORD_HEARTBEAT_MS=15000
DISCORD_JOB_LOCK_SECONDS=120

# Public web configuration.
PUBLIC_SITE_URL=http://localhost:3000
PUBLIC_SERVER_IP=45.81.234.145:27015
WEB_PORT=3000

# Optional prebuilt images. Leave unset to build locally with Compose.
# WEB_IMAGE=ghcr.io/owner/repository-web:latest
# BOT_IMAGE=ghcr.io/owner/repository-bot:latest
